# Posta — Environment Configuration
# Copy this file to .env and fill in your values

# ─── General ─────────────────────────────────────────────
POSTA_CONFIG_FILE_PATH=config/posta/posta.yml
POSTA_LOG_LEVEL=info
POSTA_WEB_HOSTNAME=localhost
POSTA_WEB_PROTOCOL=http
POSTA_SMTP_HOSTNAME=localhost

# ─── Ports ───────────────────────────────────────────────
PORT=5001
# 25 is where mail from the internet arrives, but binding it needs root on
# Linux. 2525 is fine for trying Posta locally; use 25 in production.
SMTP_PORT=2525

# ─── Database (PostgreSQL / Supabase) ────────────────────
# Main database connection URL (required). For Supabase, use the direct
# connection string from your project settings (Settings → Database).
POSTA_MAIN_DB_URL=postgresql://postgres:postgres@localhost:5432/posta_main

# Optional: separate connection URL for per-server message databases.
# If omitted, POSTA_MAIN_DB_URL is used. Each server gets its own schema.
# POSTA_MESSAGE_DB_URL=postgresql://postgres:postgres@localhost:5432/posta_main

# Optional: schema name prefix for per-server message DB schemas.
# Defaults to 'posta_server' (e.g. posta_server_1, posta_server_2).
# POSTA_MESSAGE_DB_SCHEMA_PREFIX=posta_server

# ─── Clerk Auth (frontend) ───────────────────────────────
# From https://dashboard.clerk.com → Your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ─── Clerk Auth (backend) ────────────────────────────────
# Same Clerk application as the publishable key above. No webhook is needed:
# the first account to sign in becomes the administrator, and anyone else
# needs an administrator to add their email under Administration → Users.
CLERK_SECRET_KEY=

# ─── SMTP TLS (optional) ─────────────────────────────────
# SMTP_TLS_ENABLED=true
# SMTP_TLS_CERTIFICATE_PATH=config/posta/smtp.cert
# SMTP_TLS_PRIVATE_KEY_PATH=config/posta/smtp.key

# ─── Signing Key (webhook signing) ───────────────────────
# POSTA_SIGNING_KEY_PATH=config/posta/signing.key

# ─── GELF/Graylog (optional) ─────────────────────────────
# POSTA_GELF_HOST=
# POSTA_GELF_PORT=12201

# ─── SMTP Relays (optional) ──────────────────────────────
# POSTA_SMTP_RELAYS=[{"host":"smtp.example.com","port":587,"ssl_mode":"STARTTLS"}]

# ─── API URL (for frontend) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5001

# ─── Worker ──────────────────────────────────────────────
WORKER_THREADS=2
