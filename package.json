{
  "name": "posta",
  "version": "0.1.0",
  "private": true,
  "description": "Posta \u2014 a fully featured open source mail delivery platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "bash scripts/dev.sh",
    "start:web": "bun run --cwd packages/web-server dev",
    "start:smtp": "bun run --cwd packages/smtp-server dev",
    "start:worker": "bun run --cwd packages/worker dev",
    "start:frontend": "bun run --cwd packages/frontend dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "bun test --cwd packages tests/integration/",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "docker:build": "docker build -t posta:latest .",
    "docker:run": "docker compose up"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "author": "Chris Beckett <chrisssyyyb@gmail.com>",
  "license": "MIT"
}
