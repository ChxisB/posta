{
  "name": "@posta/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node $(node -e \"console.log(require.resolve('next/dist/bin/next'))\") dev",
    "build": "node $(node -e \"console.log(require.resolve('next/dist/bin/next'))\") build",
    "start": "node .next/standalone/packages/frontend/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "author": "Chris Beckett <chrisssyyyb@gmail.com>",
  "license": "MIT"
}
