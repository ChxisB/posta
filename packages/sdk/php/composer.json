{
    "name": "chxisb/posta-php",
    "description": "Official PHP SDK for Posta — a self-hostable, Resend-compatible email API.",
    "type": "library",
    "keywords": ["email", "posta", "ses", "transactional-email", "resend-compatible"],
    "license": "MIT",
    "homepage": "https://github.com/ChxisB/posta/tree/main/packages/sdk/php",
    "version": "0.8.0",
    "support": {
        "issues": "https://github.com/ChxisB/posta/issues",
        "source": "https://github.com/ChxisB/posta/tree/main/packages/sdk/php"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "laravel/pint": "1.30.4",
        "pestphp/pest": "^2.34",
        "phpstan/phpstan": "2.2.15"
    },
    "autoload": {
        "psr-4": { "Posta\\": "src/" }
    },
    "scripts": {
        "test": "pest",
        "lint": [
            "pint --test",
            "phpstan analyse"
        ],
        "lint:fix": "pint"
    },
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
