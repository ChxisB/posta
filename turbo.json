{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "env": ["POSTA_MAIN_DB_URL", "POSTA_MESSAGE_DB_URL", "POSTA_TEST_DB_BASE_URL", "POSTA_DELIVERY_PROVIDER"],
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
