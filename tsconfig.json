{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/message-db" },
    { "path": "packages/smtp-client" },
    { "path": "packages/smtp-server" },
    { "path": "packages/web-server" },
    { "path": "packages/worker" },
    { "path": "packages/frontend" }
  ]
}
